# Python Twilio bridge server
PORT=5000

# Existing Node backend endpoint
BACKEND_AUDIO_ENDPOINT=http://localhost:3000/api/conversation/audio

# Public bridge URL used by Twilio actions (required)
# Example: https://abcd-1234.ngrok-free.app
BASE_URL=https://your-current-ngrok-url.ngrok-free.dev

# Public base URL that serves Node audio files (required if Node returns localhost URLs)
# Example: https://abcd-1234.ngrok-free.app
PUBLIC_AUDIO_BASE_URL=https://nonmonistic-dorine-unprofessorially.ngrok-free.dev

# Twilio auth for recording download (required for private Twilio recording URLs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# HTTP timeout for Twilio download and Node bridge calls
HTTP_TIMEOUT_SECONDS=20
